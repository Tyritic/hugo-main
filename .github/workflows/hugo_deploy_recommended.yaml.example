# GitHub 推荐的标准 Pages 部署工作流（示例）
name: deploy-recommended

on:
  push:
    branches:
      - main

# 关键：添加 permissions
permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          submodules: recursive

      - name: Setup Hugo
        uses: peaceiris/actions-hugo@v3
        with:
          hugo-version: "latest"
          extended: true

      - name: Build Web
        run: hugo --minify

      # GitHub 推荐：使用官方 upload-pages-artifact
      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./public

      # GitHub 推荐：使用官方 deploy-pages
      - name: Deploy to GitHub Pages
        uses: actions/deploy-pages@v4
